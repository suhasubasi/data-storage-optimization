      "end": 6.5,
      "text": "Welcome everyone to the RAN evolution session.",
      "frame_id": "f1",
      "speaker": null
    },
    {
      "id": "s2",
      "start": 96.2,
      "end": 104.8,
      "text": "As you see here, handover optimisation reduces dropped calls in dense cells.",
      "frame_id": "f2",
      "speaker": null
    },
    {
      "id": "s3",
      "start": 104.8,
      "end": 112.0,
      "text": "We tested this in three cities last spring.",
      "frame_id": "f2",
      "speaker": null
    },
    {
      "id": "s4",
      "start": 412.3,
      "end": 420.1,
      "text": "The next topic is energy saving with sleep modes for idle radio units.",
      "frame_id": "f3",
      "speaker": null
    },
    {
      "id": "s5",
      "start": 1221.0,
      "end": 1230.4,
      "text": "In the field trial we measured twelve percent lower power per site.",
