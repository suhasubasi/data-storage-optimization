            "null"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "frame_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "slide_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
